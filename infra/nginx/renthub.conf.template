# RentHub behind Nginx (NFR-4). Rendered by the nginx image from /etc/nginx/templates at start-up: ${VAR} values
# come from the container environment (docker-compose.prod.yml); Nginx's own $variables are left untouched.
#
# TODO(HTTPS): the site is served over plain HTTP for now (DECISIONS.md D-47). When a certificate exists:
#   1. add `listen 443 ssl;` with ssl_certificate / ssl_certificate_key, TLS 1.2/1.3 only;
#   2. turn this server block into a redirect `return 301 https://$host$request_uri;`;
#   3. add `Strict-Transport-Security "max-age=31536000; includeSubDomains" always;` to the headers below;
#   4. set SESSION_COOKIE_SECURE=true and APP_BASE_URL=https://... in .env (README, "Enabling HTTPS").

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Photos ≤ 5 MB, the listing video ≤ 50 MB (FR-4a, D-52), chat files ≤ 50 MB (D-57); the rest is multipart overhead.
    client_max_body_size 55m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org ${CSP_IMG_SRC_EXTRA}; media-src 'self' blob: ${CSP_IMG_SRC_EXTRA}; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # REST API -> Spring Boot (the backend service of the compose file).
    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Chat push (D-57): STOMP over WebSocket -> Spring Boot; long-lived, so a generous read timeout (STOMP heartbeats
    # keep it alive). The backend accepts the handshake only from APP_BASE_URL's origin.
    location /ws {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
    }

    # Actuator stays internal (the container healthcheck calls it directly); only health is exposed anyway.
    location /actuator/ {
        return 404;
    }

    # Listing photos from the bundled SeaweedFS bucket, read-only (S3_PUBLIC_URL=<site>/photos).
    location /photos/ {
        limit_except GET HEAD { deny all; }
        proxy_pass http://s3:8333/${S3_BUCKET}/;
        proxy_set_header Host s3:8333;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Hashed build assets never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA routes fall back to index.html, which must not be cached.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org ${CSP_IMG_SRC_EXTRA}; media-src 'self' blob: ${CSP_IMG_SRC_EXTRA}; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    }
}
