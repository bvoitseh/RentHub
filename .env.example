# Copy to .env (never commit .env); `./gradlew bootRun` exports it automatically. The application works without any
# of these: embedded H2, Mailpit on localhost:1025.
# Variables marked "later" are read by features that are not implemented yet; they are listed so the file stays complete.

# --- Server / app ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:5173          # public SPA URL used in e-mail links
MAIL_FROM=noreply@renthub.local

# --- SMTP (default: Mailpit from docker-compose; any SMTP relay works, e.g. Gmail with an app password) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# --- Admin bootstrap (FR-2a): created at start-up only if no ADMIN exists and all three are set ---
ADMIN_EMAIL=renthub.noreply+admin@gmail.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Адміністратор

# --- Rate limits (NFR-14): attempts per window; windows are fixed (login 15 min, others 1 h) ---
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTRATION=5
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_RESEND_VERIFICATION=3

# --- S3-compatible object storage (FR-4a, catalogue feature, later; default: MinIO from docker-compose) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=renthub-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/renthub-photos

# --- Geocoding (FR-4, catalogue feature, later) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RentHub/0.1 (contact: you@example.com)
