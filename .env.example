# Copy to .env (never commit .env). The dev profile works without any of these: H2, Mailpit on localhost:1025.
# Variables marked "later" are read by features that are not implemented yet; they are listed so the file stays complete.

# --- Server / app ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:5173          # public SPA URL used in e-mail links
MAIL_FROM=noreply@renthub.local

# --- Database (prod profile only; dev uses embedded H2) ---
DB_URL=jdbc:postgresql://localhost:5432/renthub
DB_USERNAME=renthub
DB_PASSWORD=renthub
# Used by docker-compose for the local PostgreSQL container
POSTGRES_DB=renthub
POSTGRES_USER=renthub
POSTGRES_PASSWORD=renthub

# --- SMTP (dev: Mailpit from docker-compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# --- Admin bootstrap (FR-2a, accounts feature, later) ---
ADMIN_EMAIL=admin@renthub.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Адміністратор

# --- S3-compatible object storage (FR-4a, catalogue feature, later; dev: MinIO from docker-compose) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=renthub-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/renthub-photos

# --- Geocoding (FR-4, catalogue feature, later) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=RentHub/0.1 (contact: you@example.com)
